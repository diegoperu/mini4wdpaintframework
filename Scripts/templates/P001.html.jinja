<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<style>{{ font_faces }}</style>
<style>
  :root {
    --tamiya-primary: {{ tokens.colors.primary.TamiyaPrimary }};
    --tamiya-dark: {{ tokens.colors.primary.TamiyaDark }};
    --white: {{ tokens.colors.neutral.White }};
    --off-white: {{ tokens.colors.neutral.OffWhite }};
    --light-gray: {{ tokens.colors.neutral.LightGray }};
    --mid-gray: {{ tokens.colors.neutral.MidGray }};
    --title-font: {{ tokens.typography.fonts.TitleFont }};
    --body-font: {{ tokens.typography.fonts.BodyFont }};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: {{ mm(210) }};
    height: {{ mm(297) }};
    background: var(--white);
    font-family: var(--body-font);
    position: relative;
    overflow: hidden;
  }

  /* C001 — Header (variant: cover — right zone empty) */
  .header {
    height: {{ mm(18) }};
    background: var(--tamiya-primary);
    color: var(--white);
    display: flex;
    align-items: center;
    padding: 0 {{ mm(6) }};
  }
  .header .brand { font-family: var(--title-font); font-size: 14pt; letter-spacing: 0.5px; }

  /* C002 — Footer */
  .footer {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: {{ mm(12) }};
    background: var(--white);
    border-top: 1.5pt solid var(--tamiya-primary);
    display: flex;
    align-items: center;
    padding: 0 {{ mm(6) }};
    font-size: 9pt;
    color: var(--mid-gray);
  }
  .footer .right { margin-left: auto; font-size: 8pt; color: var(--tamiya-primary); font-weight: 600; }

  /* Kicker: dicitura fissa (uguale per ogni progetto SDK, non da content.yaml -
     stesso trattamento del wordmark header e del footer) che riempie lo spazio
     altrimenti vuoto sopra il render 3/4 (landscape) e dichiara cos'e' il documento. */
  .kicker {
    position: absolute;
    top: {{ mm(50) }};
    left: 0; right: 0;
    text-align: center;
    padding: 0 {{ mm(6) }};
    color: var(--tamiya-primary);
    font-family: var(--title-font);
    font-size: 28pt;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  /* Full-bleed cover render zone: header bottom -> footer top */
  .cover-render {
    position: absolute;
    top: {{ mm(18) }};
    bottom: {{ mm(12) }};
    left: 0; right: 0;
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* contain, non cover: una vista 3/4 e' tipicamente piu' larga che alta - "cover"
     dentro un contenitore verticale riempie l'altezza e ritaglia i lati (muso/coda).
     "contain" adatta alla larghezza e mostra il modello intero, senza tagli. */
  .cover-render img { width: 100%; height: 100%; object-fit: contain; }
  .render-placeholder-label {
    background: var(--off-white);
    border: 1.5pt dashed var(--light-gray);
    color: var(--mid-gray);
    font-size: 9pt;
    text-align: center;
    padding: {{ mm(4) }};
    width: 80%;
  }

  /* Title overlay band: bottom quarter of the render, semi-transparent primary color */
  .title-band {
    position: absolute;
    left: 0; right: 0; bottom: {{ mm(12) }};
    height: 25%;
    background: rgba(17, 75, 105, 0.88); /* TamiyaPrimary @ 88% */
    color: var(--white);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 {{ mm(10) }};
  }
  .title-band .model-name { font-family: var(--title-font); font-size: 34pt; line-height: 1.1; }
  .title-band .scheme-name { font-size: 18pt; margin-top: {{ mm(2) }}; opacity: 0.95; }
  .title-band .series { font-size: 10pt; margin-top: {{ mm(3) }}; opacity: 0.85; }
</style>
</head>
<body>

  <div class="header">
    <div class="brand">Mini4WD Manual</div>
  </div>

  <div class="cover-render">
    {% if images.cover.data_uri %}
    <img src="{{ images.cover.data_uri }}" alt="{{ content.render.alt }}">
    {% else %}
    <div class="render-placeholder-label">
      TODO: render di copertina — {{ images.cover.path }}<br>
      angolo: {{ content.render.angle }} — illuminazione: {{ content.render.lighting }}<br>
      (Fase 4 — non ancora generato)
    </div>
    {% endif %}
  </div>

  <div class="kicker">Guida alla Verniciatura</div>

  <div class="title-band">
    <div class="model-name">{{ content.title }}</div>
    <div class="scheme-name">{{ content.subtitle }}</div>
    <div class="series">{{ content.series }}</div>
  </div>

  <div class="footer">
    <div class="left">Mini4WD Manual SDK</div>
    <div class="right">{{ content.footer.page_id }}</div>
  </div>

</body>
</html>
